APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/studymate
APP_NAME=StudyMate
APP_TIMEZONE=UTC
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studymate
DB_USER=root
DB_PASSWORD=
SESSION_LIFETIME=120
STALE_SESSION_THRESHOLD=300
UPLOAD_MAX_SIZE=10485760
CSRF_TOKEN_NAME=studymate_csrf

# Outgoing email
# MAIL_TRANSPORT: smtp | mail | log   ("log" writes messages to storage/logs/mail.log)
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION: tls | ssl | none
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME=StudyMate
